{% set currentCopyrightYear = "" | currentYear %}
{% set copyrightYears = site.copyrightStartYear %}
{% if currentCopyrightYear != site.copyrightStartYear %}
  {% set copyrightYears = site.copyrightStartYear ~ "-" ~ currentCopyrightYear %}
{% endif %}
{% set copyrightNotice = "© " ~ copyrightYears ~ " " ~ site.name ~ ". All rights reserved." %}
<!doctype html>
<html lang="{{ site.language }}" data-site-origin="{{ site.canonicalHost }}">
<head>
  <!-- Original CertHappens.com site build. Usage: https://certhappens.com/copyright/ -->
  {% if environment.googleAnalyticsMeasurementId %}
  <!-- Google Analytics is loaded only on the approved CertHappens.com hostnames. -->
  <script data-production-analytics>
    (() => {
      const measurementId = {{ environment.googleAnalyticsMeasurementId | json | safe }};
      const allowedHosts = {{ site.analyticsHosts | json | safe }};
      const currentHost = window.location.hostname.toLowerCase();

      if (!allowedHosts.includes(currentHost)) {
        return;
      }

      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function gtag(){window.dataLayer.push(arguments);};
      window.gtag("js", new Date());
      window.gtag("config", measurementId);

      const googleTag = document.createElement("script");
      googleTag.async = true;
      googleTag.src = "https://www.googletagmanager.com/gtag/js?id={{ environment.googleAnalyticsMeasurementId }}";
      document.head.appendChild(googleTag);
    })();
  </script>
  {% endif %}
  {% set pageDescription = description or site.description %}
  {% set canonicalUrl = site.url ~ page.url %}
  {% set socialImageUrl = site.url ~ site.socialImagePath %}
  {% set fullTitle = title %}
  {% if title != site.name %}
    {% set fullTitle = title ~ " | " ~ site.name %}
  {% endif %}

  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="author" content="{{ site.name }}">
  <meta name="copyright" content="{{ copyrightNotice }}">
  <meta name="color-scheme" content="dark light">
  <meta name="theme-color" content="#10141d">

  <title>{{ fullTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  {% set pageRobots = robots or "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" %}
  {% if not environment.isProductionBuild %}
    {% set pageRobots = "noindex,nofollow,nosnippet" %}
  {% endif %}
  <meta name="robots" content="{{ pageRobots }}">
  <link rel="canonical" href="{{ canonicalUrl }}">

  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:title" content="{{ fullTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:image" content="{{ socialImageUrl }}">
  <meta property="og:image:width" content="{{ site.socialImageWidth }}">
  <meta property="og:image:height" content="{{ site.socialImageHeight }}">
  <meta property="og:image:alt" content="CertHappens.com certification practice and study resources">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ fullTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ socialImageUrl }}">

  <link rel="icon" href="/assets/brand/favicon-v2.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32-v2.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16-v2.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon-v2.png">
  <link rel="manifest" href="/site.webmanifest">

  <link rel="stylesheet" href="/assets/css/site.css">
  <link rel="stylesheet" href="/assets/css/brand.css">
  <link rel="stylesheet" href="/assets/css/phase6.css">
  <link rel="stylesheet" href="/assets/css/navigation.css">
  {% if stylesheets %}
  {% for stylesheet in stylesheets %}
  <link rel="stylesheet" href="{{ stylesheet }}">
  {% endfor %}
  {% endif %}
  {% if printable %}
  <link rel="stylesheet" href="/assets/css/print.css" media="print">
  {% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "{{ site.url }}/#organization",
        "name": {{ site.name | json | safe }},
        "url": {{ site.url | json | safe }},
        "logo": {
          "@type": "ImageObject",
          "url": {{ (site.url ~ site.logoPath) | json | safe }}
        }
      },
      {
        "@type": "WebSite",
        "@id": "{{ site.url }}/#website",
        "url": {{ site.url | json | safe }},
        "name": {{ site.name | json | safe }},
        "description": {{ site.description | json | safe }},
        "publisher": {
          "@id": "{{ site.url }}/#organization"
        },
        "copyrightHolder": {
          "@id": "{{ site.url }}/#organization"
        },
        "copyrightNotice": {{ copyrightNotice | json | safe }},
        "copyrightYear": {{ site.copyrightStartYear }},
        "inLanguage": {{ site.language | json | safe }}
      },
      {
        "@type": "WebPage",
        "@id": "{{ canonicalUrl }}#webpage",
        "url": {{ canonicalUrl | json | safe }},
        "name": {{ fullTitle | json | safe }},
        "description": {{ pageDescription | json | safe }},
        "isPartOf": {
          "@id": "{{ site.url }}/#website"
        },
        "copyrightHolder": {
          "@id": "{{ site.url }}/#organization"
        },
        "copyrightNotice": {{ copyrightNotice | json | safe }},
        "copyrightYear": {{ site.copyrightStartYear }},
        "inLanguage": {{ site.language | json | safe }}
      }
      {% if breadcrumbs %},
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {% for crumb in breadcrumbs %}
          {
            "@type": "ListItem",
            "position": {{ loop.index }},
            "name": {{ crumb.label | json | safe }},
            "item": {{ (site.url ~ (crumb.url or page.url)) | json | safe }}
          }{% if not loop.last %},{% endif %}
          {% endfor %}
        ]
      }
      {% endif %}
    ]
  }
  </script>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <header class="site-header" data-site-header>
    <div class="site-header__inner page-shell">
      <a class="site-brand" href="/" aria-label="{{ site.name }} home">
        <img
          class="site-brand__logo"
          src="/assets/brand/certhappens-header-mark-v2.png"
          width="640"
          height="451"
          alt=""
          aria-hidden="true"
        >
        <span class="site-brand__wordmark" aria-hidden="true">
          <span class="site-brand__cert">Cert</span><span class="site-brand__happens">Happens</span><span class="site-brand__dotcom">.com</span>
        </span>
      </a>

      {% if printable %}
      <span class="site-header__print-title" aria-hidden="true">{{ printTitle or title }}</span>
      {% endif %}

      <button
        class="site-nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primary-navigation"
        hidden
        data-site-nav-toggle
      >
        <span class="site-nav-toggle__icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
        <span data-site-nav-toggle-label>Menu</span>
      </button>

      <nav
        class="primary-nav"
        id="primary-navigation"
        aria-label="Primary navigation"
        data-primary-navigation
        data-open="false"
      >
        {% for item in siteNavigation.primary %}
          {% if item.groups %}
          <details
            class="primary-nav__details"
            data-nav-submenu
            data-nav-prefix="{{ item.matchPrefix }}"
          >
            <summary
              class="primary-nav__summary"
              aria-controls="{{ item.menuId }}"
              aria-expanded="false"
            >
              <span>{{ item.label }}</span>
              <span class="primary-nav__chevron" aria-hidden="true"></span>
            </summary>
            <div class="primary-nav__submenu" id="{{ item.menuId }}">
              {% for group in item.groups %}
              <section class="primary-nav__group" aria-labelledby="{{ item.menuId }}-group-{{ loop.index }}">
                <p class="primary-nav__group-label" id="{{ item.menuId }}-group-{{ loop.index }}">{{ group.label }}</p>
                <div class="primary-nav__group-links">
                  {% for link in group.links %}
                  <a class="primary-nav__submenu-link" href="{{ link.url }}">{{ link.label }}</a>
                  {% endfor %}
                </div>
              </section>
              {% endfor %}
            </div>
          </details>
          {% else %}
          <a
            class="primary-nav__link{% if item.icon %} primary-nav__link--icon{% endif %}"
            href="{{ item.url }}"
            data-nav-prefix="{{ item.matchPrefix }}"
            {% if item.icon %}aria-label="{{ item.label }}" title="{{ item.label }}"{% endif %}
          >
            {% if item.icon == "search" %}
            <svg class="primary-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.6-3.6"></path>
            </svg>
            <span class="primary-nav__icon-label">{{ item.label }}</span>
            {% else %}
            {{ item.label }}
            {% endif %}
          </a>
          {% endif %}
        {% endfor %}
      </nav>
    </div>
  </header>

  <main id="main-content" tabindex="-1">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="page-shell site-footer__inner">
      <nav class="site-footer__nav" aria-label="Footer navigation">
        {% for item in siteNavigation.footer %}
        <a href="{{ item.url }}">{{ item.label }}</a>
        {% endfor %}
      </nav>
      <p>{{ copyrightNotice }}</p>
      <p class="site-footer__disclaimer">
        This independent study resource is not affiliated with or endorsed by CompTIA, ISC2, or Cisco.
        CompTIA, Security+, and Network+ are trademarks of CompTIA, Inc. ISC2 and CISSP are registered marks of ISC2, Inc. Cisco, CCNA, and related marks belong to Cisco Systems, Inc. and/or its affiliates.
      </p>
    </div>
  </footer>
  <script src="/assets/js/site-navigation.js"></script>
</body>
</html>
